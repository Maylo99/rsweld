// RSweld – Prisma schema
//
// Prisma 7 note: connection URLs live in `prisma.config.ts` (for Migrate) and in
// the driver adapter passed to `PrismaClient` (for runtime) — not in this block.

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InquiryType {
  CONTACT
  QUOTE
}

/// Website sections a photo can be shown in. Labels, limits and descriptions
/// live in `lib/placements.ts`.
enum Placement {
  GALLERY // the /galeria page ("Všetky" + tag filters)
  HOME_FEATURED // homepage "Vybrané projekty"
  HOME_ABOUT // homepage "O nás" image (single)
}

model Inquiry {
  id        String      @id @default(cuid())
  type      InquiryType
  name      String
  email     String
  phone     String?
  message   String
  /// Path of an uploaded drawing/attachment in Supabase Storage (quote requests).
  filePath  String?
  createdAt DateTime    @default(now())

  @@map("inquiries")
}

model Photo {
  id          String           @id @default(cuid())
  title       String
  description String?
  /// Public path of the image (Supabase Storage `references` bucket or /public).
  imagePath   String
  /// Slovak alt text for the image (accessibility + SEO).
  imageAlt    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  tags        PhotoTag[]
  placements  PhotoPlacement[]

  @@map("photos")
}

/// Gallery filter tag. `sortOrder` is the order of the filter chips.
model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  photos    PhotoTag[]

  @@map("tags")
}

/// Photo ↔ tag membership. `sortOrder` is the photo's position when the
/// gallery is filtered by this tag — independent of every other list.
model PhotoTag {
  photoId   String
  tagId     String
  sortOrder Int    @default(0)
  photo     Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photoId, tagId])
  @@index([tagId, sortOrder])
  @@map("photo_tags")
}

/// Photo shown in a website section, with its own position in that section.
model PhotoPlacement {
  photoId   String
  placement Placement
  sortOrder Int       @default(0)
  photo     Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([photoId, placement])
  @@index([placement, sortOrder])
  @@map("photo_placements")
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  company   String?
  quote     String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}
