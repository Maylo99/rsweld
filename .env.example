# ---------------------------------------------------------------------------
# RSweld – environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Prisma / Supabase Postgres
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used at runtime by the
#   Prisma driver adapter. Append `?pgbouncer=true&connection_limit=1`.
# DIRECT_URL:   direct connection (port 5432) — used by Prisma Migrate.
# Both are found in Supabase → Project Settings → Database → Connection string.
DATABASE_URL=
DIRECT_URL=

# Supabase (Project Settings → API)
# Storage buckets: `references` (public read, gallery) and `inquiries`
# (private, quote-form attachments) — see README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend – transactional email (https://resend.com → API Keys)
RESEND_API_KEY=
# Verified sender, e.g. "RSweld <dopyty@rsweld.sk>"
RESEND_FROM_EMAIL=
# Inbox that receives inquiry notifications
NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Admin area (/admin) — single administrator, credentials live here only.
# With any of these three missing the admin area is disabled (no default
# password is ever assumed).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=rsweldsk@gmail.com
# Change this before going live — it is the only thing protecting the admin.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=
