# ---------------------------------------------------------------------------
# RSweld – environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Postgres (Railway → Postgres service → Variables)
# DATABASE_URL: runtime connection. On Railway reference the private URL:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DIRECT_URL:   public TCP proxy URL, used by Prisma Migrate and by `next build`
#   (the private network is unreachable during builds):
#   DIRECT_URL=${{Postgres.DATABASE_PUBLIC_URL}}
#   Optional locally - Migrate falls back to DATABASE_URL.
# Local (docker compose up -d):
#   DATABASE_URL=postgresql://rsweld:rsweld@localhost:5432/rsweld
DATABASE_URL=
DIRECT_URL=

# S3-compatible object storage (Railway → Bucket service → Credentials)
# One private bucket: `gallery/` (served via /media) and `inquiries/`
# (quote-form attachments, presigned links). On Railway reference the bucket:
#   S3_BUCKET=${{Bucket.BUCKET}}
#   S3_ENDPOINT=${{Bucket.ENDPOINT}}
#   S3_REGION=${{Bucket.REGION}}
#   S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
#   S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# Local S3Mock (docker compose up -d): S3_BUCKET=rsweld,
#   S3_ENDPOINT=http://localhost:9090, any keys, S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `true` for local S3Mock and older Railway buckets (path-style URLs).
S3_FORCE_PATH_STYLE=

# Sample photos (seed set in public/references) on the public site:
#   show - always shown, after the real photos; hide - never shown (also hides
#   rows created by `pnpm db:seed`); empty - database content as is.
SAMPLE_PHOTOS=

# Resend – transactional email (https://resend.com → API Keys)
RESEND_API_KEY=
# Verified sender, e.g. "RSweld <dopyty@rsweld.sk>"
RESEND_FROM_EMAIL=
# Inbox that receives inquiry notifications
NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Admin area (/admin) — single administrator, credentials live here only.
# With any of these three missing the admin area is disabled (no default
# password is ever assumed).
# ---------------------------------------------------------------------------
ADMIN_EMAIL=rsweldsk@gmail.com
# Change this before going live — it is the only thing protecting the admin.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
AUTH_SECRET=
